+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MT7621_CR660X_OVERCLOCK_H
+#define _MT7621_CR660X_OVERCLOCK_H
+
+#include <linux/math64.h>
+#include <linux/types.h>
+
+#define CR660X_CPU_TARGET_HZ 1100000000U
+
+/* Calculate only. Do not change the PLL pre-divider, other bits or DDR. */
+static inline bool mt7621_cr660x_1100_plan(u32 pll, u32 xtal,
+                                         u32 fdiv, u32 ffrac, u32 *result)
+{
+    const u32 shift_table[] = { 0, 1, 2, 2 };
+    const u32 mask = 0x7fU << 4;
+    u32 shift = shift_table[(pll >> 12) & 3];
+    u32 remainder, current_denominator, denominator;
+    u64 count, observed_hz;
+
+    if (!result || (xtal != 20000000U && xtal != 25000000U &&
+                    xtal != 40000000U) || !fdiv || fdiv > 31 ||
+                    !ffrac || ffrac > 31)
+        return false;
+
+    current_denominator = fdiv << shift;
+    observed_hz = div_u64_rem((u64)(((pll >> 4) & 0x7f) + 1) *
+                          xtal * ffrac, current_denominator, &remainder);
+    if (remainder || (observed_hz != 880000000U &&
+                      observed_hz != CR660X_CPU_TARGET_HZ))
+        return false;
+
+    denominator = xtal * ffrac;
+    count = div_u64_rem(((u64)CR660X_CPU_TARGET_HZ * fdiv) << shift,
+                        denominator, &remainder);
+    if (remainder || !count || count > 128)
+        return false;
+
+    *result = (pll & ~mask) | ((u32)(count - 1) << 4);
+    return true;
+}
+
+#endif
